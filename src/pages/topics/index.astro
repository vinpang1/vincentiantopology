---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => data.section === 'topics' && !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="專題探討" description="專題探討 · Topics">
  <h1>專題探討</h1>
  <p class="page__subtitle">Topics</p>

  {
    sortedPosts.length > 0 ? (
      <ul class="post-list">
        {sortedPosts.map((post) => (
          <li>
            <a href={`/topics/${post.id}/`}>{post.data.title}</a>
            <span class="post-list__meta">
              {post.data.pubDate.toLocaleDateString('zh-Hant-TW')}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">此專區尚無文章，內容將於後續發布。</p>
    )
  }
</BaseLayout>
