---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => data.section === 'view' && !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文森世界" description="文森世界 · Vincentian World">
  <h1>文森世界</h1>
  <p class="page__subtitle">Vincentian World</p>

  {
    sortedPosts.length > 0 ? (
      <ul class="post-list">
        {sortedPosts.map((post) => (
          <li>
            <a href={`/view/${post.id}/`}>{post.data.title}</a>
            <span class="post-list__meta">
              {post.data.pubDate.toLocaleDateString('zh-Hant-TW')}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">此專區尚無文章，內容將於後續發布。</p>
    )
  }
</BaseLayout>
