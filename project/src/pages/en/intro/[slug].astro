---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sections } from '../../../site.config';
import {
  navigationForIntro,
  slugFromId,
} from '../../../lib/content';
import { introHreflangAlternates } from '../../../lib/article-paths';
import {
  getArticleStructuredMeta,
  getRelatedArticlesForContentId,
} from '../../../lib/articles-index';

export async function getStaticPaths() {
  const sectionHref = `/en${sections.intro.href}`;
  const entries = await getCollection(
    'intro',
    ({ data }) => !data.draft && data.lang === 'en',
  );
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: {
      entry,
      navigation: navigationForIntro(
        entries,
        entry,
        sectionHref,
        sections.intro.labelEn,
        'en',
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
const contentId = slugFromId(entry.id);
const relatedArticles = getRelatedArticlesForContentId(contentId);
const structuredMeta = getArticleStructuredMeta(contentId);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={`${sections.intro.labelEn} · 0-${entry.data.order}`}
  published={entry.data.published}
  lang="en"
  navigation={navigation}
  hreflangAlternates={introHreflangAlternates(slugFromId(entry.id))}
  relatedArticles={relatedArticles}
  structuredMeta={structuredMeta}
>
  <Content />
</ArticleLayout>
