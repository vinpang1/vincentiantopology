---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sections } from '../../../site.config';
import {
  navigationForView,
  slugFromId,
} from '../../../lib/content';
import { viewHreflangAlternates } from '../../../lib/article-paths';

export async function getStaticPaths() {
  const sectionHref = `/en${sections.view.href}`;
  const entries = await getCollection(
    'view',
    ({ data }) => !data.draft && data.lang === 'en',
  );
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: {
      entry,
      navigation: navigationForView(
        entries,
        entry,
        sectionHref,
        sections.view.labelEn,
        'en',
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={sections.view.labelEn}
  published={entry.data.published}
  lang="en"
  navigation={navigation}
  hreflangAlternates={viewHreflangAlternates(slugFromId(entry.id))}
>
  <Content />
</ArticleLayout>
