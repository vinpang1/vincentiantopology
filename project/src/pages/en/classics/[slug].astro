---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sections } from '../../../site.config';
import {
  navigationForClassics,
  slugFromId,
} from '../../../lib/content';

export async function getStaticPaths() {
  const sectionHref = `/en${sections.classics.href}`;
  const entries = await getCollection(
    'classics',
    ({ data }) => !data.draft && data.lang === 'en',
  );
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: {
      entry,
      navigation: navigationForClassics(
        entries,
        entry,
        sectionHref,
        sections.classics.labelEn,
        'en',
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={sections.classics.labelEn}
  published={entry.data.published}
  lang="en"
  navigation={navigation}
>
  <Content />
</ArticleLayout>
