---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sections } from '../../../site.config';
import { getTopicSeries, formatDate } from '../../../lib/content';

const seriesList = await getTopicSeries('en');
---

<BaseLayout lang="en" title={sections.topics.labelEn}>
  <header class="page-header">
    <p class="page-header__eyebrow">{sections.topics.labelEn}</p>
    <h1 class="page-header__title">{sections.topics.labelEn}</h1>
    <p class="page-header__desc">
      One theme, many angles—written deep. Each series stands on its own.
    </p>
  </header>

  {
    seriesList.length === 0 ? (
      <p class="placeholder-note">
        English topic series will be listed here.
      </p>
    ) : (
      seriesList.map((series) => (
        <section class="series-group">
          <h2 class="series-group__title">{series.title}</h2>
          <ul class="article-list">
            {series.entries.map((entry) => (
              <li class="article-list__item">
                <a
                  class="article-list__link"
                  href={`/en/topics/${entry.data.series}/${entry.data.episode}`}
                >
                  <span class="article-list__meta">
                    Part {entry.data.episode} ·{' '}
                    {formatDate(entry.data.published, 'en')}
                  </span>
                  <h3 class="article-list__title">{entry.data.title}</h3>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
