---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { sections } from '../../../../site.config';
import { navigationForTopics } from '../../../../lib/content';

export async function getStaticPaths() {
  const sectionHref = `/en${sections.topics.href}`;
  const entries = await getCollection(
    'topics',
    ({ data }) => !data.draft && data.lang === 'en',
  );
  return entries.map((entry) => ({
    params: {
      series: entry.data.series,
      episode: String(entry.data.episode),
    },
    props: {
      entry,
      navigation: navigationForTopics(
        entries,
        entry,
        sectionHref,
        sections.topics.labelEn,
        'en',
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={`${sections.topics.labelEn} · ${entry.data.seriesTitle} · Part ${entry.data.episode}`}
  published={entry.data.published}
  lang="en"
  navigation={navigation}
>
  <Content />
</ArticleLayout>
