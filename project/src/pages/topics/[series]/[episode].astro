---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sections } from '../../../site.config';

export async function getStaticPaths() {
  const entries = await getCollection('topics', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: {
      series: entry.data.series,
      episode: String(entry.data.episode),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={`${sections.topics.labelZh} · ${entry.data.seriesTitle} · 第 ${entry.data.episode} 期`}
  published={entry.data.published}
  lang={entry.data.lang}
>
  <Content />
</ArticleLayout>
