---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sections } from '../../../site.config';
import { navigationForTopics } from '../../../lib/content';
import { topicHreflangAlternates } from '../../../lib/article-paths';

export async function getStaticPaths() {
  const entries = await getCollection(
    'topics',
    ({ data }) => !data.draft && data.lang === 'zh-Hant',
  );
  return entries.map((entry) => ({
    params: {
      series: entry.data.series,
      episode: String(entry.data.episode),
    },
    props: {
      entry,
      navigation: navigationForTopics(
        entries,
        entry,
        sections.topics.href,
        sections.topics.labelZh,
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={`${sections.topics.labelZh} · ${entry.data.seriesTitle} · 第 ${entry.data.episode} 期`}
  published={entry.data.published}
  lang={entry.data.lang}
  navigation={navigation}
  hreflangAlternates={topicHreflangAlternates(
    entry.data.series,
    entry.data.episode,
  )}
>
  <Content />
</ArticleLayout>
