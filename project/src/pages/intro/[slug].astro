---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { sections } from '../../site.config';
import {
  navigationForIntro,
  slugFromId,
} from '../../lib/content';
import { introHreflangAlternates } from '../../lib/article-paths';

export async function getStaticPaths() {
  const entries = await getCollection(
    'intro',
    ({ data }) => !data.draft && data.lang === 'zh-Hant',
  );
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: {
      entry,
      navigation: navigationForIntro(
        entries,
        entry,
        sections.intro.href,
        sections.intro.labelZh,
      ),
    },
  }));
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={`${sections.intro.labelZh} · 0-${entry.data.order}`}
  published={entry.data.published}
  lang={entry.data.lang}
  navigation={navigation}
  hreflangAlternates={introHreflangAlternates(slugFromId(entry.id))}
  topics={entry.data.topics}
>
  <Content />
</ArticleLayout>
