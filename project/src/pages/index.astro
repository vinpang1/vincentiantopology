---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, sections } from '../site.config';
import {
  getPublishedIntro,
  getLatestArticles,
  formatDate,
  slugFromId,
} from '../lib/content';

const [introArticles, latestPool] = await Promise.all([
  getPublishedIntro(),
  getLatestArticles(5),
]);

type FeaturedArticle = (typeof latestPool)[number] & {
  section: 'view' | 'topics' | 'classics' | 'intro';
};

const primaryFeatured = latestPool[0] ?? null;
let featured: FeaturedArticle | null = primaryFeatured;

if (!featured && introArticles.length > 0) {
  const introLatest = [...introArticles].sort(
    (a, b) => b.data.published.getTime() - a.data.published.getTime(),
  )[0];
  featured = {
    href: `/intro/${slugFromId(introLatest.id)}`,
    title: introLatest.data.title,
    description: introLatest.data.description,
    section: 'intro',
    published: introLatest.data.published,
  };
}

const latest = primaryFeatured
  ? latestPool.slice(1, 5)
  : latestPool.slice(0, 4);

const readHref =
  introArticles.length > 0
    ? `/intro/${slugFromId(introArticles[0].id)}`
    : sections.intro.href;

const taglineLines = site.tagline.split(/(?<=；)|(?<=：)/).filter(Boolean);

const heroDek =
  '給當代迷惘讀者——看見兩極之間的拉扯，而非急於判斷對錯。';

const sectionLabelZh: Record<
  'view' | 'topics' | 'classics' | 'intro',
  string
> = {
  intro: sections.intro.labelZh,
  view: sections.view.labelZh,
  topics: sections.topics.labelZh,
  classics: sections.classics.labelZh,
};

const sectionNav = [
  {
    href: sections.intro.href,
    title: sections.intro.labelZh,
    desc: '歡迎來到文森思維。',
  },
  {
    href: sections.view.href,
    title: sections.view.labelZh,
    desc: '當下議題，一個判斷',
  },
  {
    href: sections.topics.href,
    title: sections.topics.labelZh,
    desc: '同一主題，多角度深讀',
  },
  {
    href: sections.classics.href,
    title: sections.classics.labelZh,
    desc: '經典長解讀，慢讀',
  },
];
---

<BaseLayout>
  <h1 class="visually-hidden">{site.name}</h1>

  <section class="hero" aria-labelledby="hero-claim">
    <p class="hero__kicker">本期通訊</p>
    <p id="hero-claim" class="hero__claim">
      {
        taglineLines.map((line) => (
          <span class="hero__claim-line">{line}</span>
        ))
      }
    </p>
    <p class="hero__dek">{heroDek}</p>
    <div class="hero__actions">
      <a class="btn btn--primary btn--pill" href={readHref}>
        開始閱讀 →
      </a>
      <a
        class="btn btn--ghost"
        href={site.subscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        訂閱電子報
      </a>
    </div>
  </section>

  {
    featured && (
      <section class="featured-block" aria-labelledby="featured-heading">
        <h2 id="featured-heading" class="section-heading">最新焦點</h2>
        <a class="featured-card" href={featured.href}>
          <span class="featured-card__meta">
            {sectionLabelZh[featured.section]} ·{' '}
            {formatDate(featured.published)}
          </span>
          <h3 class="featured-card__title">{featured.title}</h3>
          {featured.description && (
            <p class="featured-card__desc">{featured.description}</p>
          )}
        </a>
      </section>
    )
  }

  <section class="section-block section-block--nav" aria-labelledby="columns-heading">
    <h2 id="columns-heading" class="section-heading">欄目</h2>
    <nav class="section-nav" aria-label="欄目">
      {
        sectionNav.map((item) => (
          <a class="section-nav__row" href={item.href}>
            <span class="section-nav__title">{item.title}</span>
            <span class="section-nav__desc">{item.desc}</span>
          </a>
        ))
      }
    </nav>
  </section>

  {
    introArticles.length > 0 && (
      <section class="section-block">
        <h2 class="section-heading">關於我們</h2>
        <ul class="article-list">
          {introArticles.map((entry) => (
            <li class="article-list__item">
              <a
                class="article-list__link"
                href={`/intro/${slugFromId(entry.id)}`}
              >
                <span class="article-list__meta">
                  0-{entry.data.order} · {formatDate(entry.data.published)}
                </span>
                <h3 class="article-list__title">{entry.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="section-block">
        <h2 class="section-heading">最新文章</h2>
        <ul class="article-list">
          {latest.map((item) => (
            <li class="article-list__item">
              <a class="article-list__link" href={item.href}>
                <span class="article-list__meta">
                  {formatDate(item.published)}
                </span>
                <h3 class="article-list__title">{item.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
