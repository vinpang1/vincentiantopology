---
import BaseLayout from './BaseLayout.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import { formatDate, type ArticleNavigationData } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  sectionLabel: string;
  published: Date;
  lang?: 'zh-Hant' | 'en';
  navigation?: ArticleNavigationData;
}

const {
  title,
  description,
  sectionLabel,
  published,
  lang = 'zh-Hant',
  navigation,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  narrow
  articleReading
  columnsHref={navigation?.sectionHref}
  lang={lang}
>
  <article class="article-reading">
    {
      navigation && (
        <ArticleNavigation placement="top" {...navigation} />
      )
    }
    <header class="page-header">
      <p class="page-header__eyebrow">{sectionLabel}</p>
      <h1 class="page-header__title">{title}</h1>
      <p class="article-meta">
        <time datetime={published.toISOString()}>{formatDate(published, lang)}</time>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      navigation && (
        <ArticleNavigation placement="bottom" {...navigation} />
      )
    }
  </article>
</BaseLayout>
