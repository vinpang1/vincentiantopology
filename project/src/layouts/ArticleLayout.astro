---
import BaseLayout from './BaseLayout.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import ThreadsFollowSoft from '../components/ThreadsFollowSoft.astro';
import { formatDate, type ArticleNavigationData } from '../lib/content';
import {
  authorName,
  publisherName,
  type HreflangAlternate,
} from '../lib/article-paths';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  sectionLabel: string;
  published: Date;
  lang?: 'zh-Hant' | 'en';
  navigation?: ArticleNavigationData;
  hreflangAlternates?: HreflangAlternate[];
}

const {
  title,
  description,
  sectionLabel,
  published,
  lang = 'zh-Hant',
  navigation,
  hreflangAlternates,
} = Astro.props;

const articleDescription = description ?? '';
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: articleDescription,
  datePublished: published.toISOString(),
  inLanguage: lang === 'en' ? 'en' : 'zh-Hant',
  author: {
    '@type': 'Person',
    name: authorName(lang),
  },
  publisher: {
    '@type': 'Organization',
    name: publisherName(lang),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
};
---

<BaseLayout
  title={title}
  description={articleDescription}
  narrow
  articleReading
  columnsHref={navigation?.sectionHref}
  lang={lang}
  ogType="article"
  published={published}
  hreflangAlternates={hreflangAlternates}
  jsonLd={jsonLd}
>
  <article class="article-reading">
    {
      navigation && (
        <ArticleNavigation placement="top" lang={lang} {...navigation} />
      )
    }
    <header class="page-header">
      <p class="page-header__eyebrow">{sectionLabel}</p>
      <h1 class="page-header__title">{title}</h1>
      <p class="article-meta">
        <time datetime={published.toISOString()}>{formatDate(published, lang)}</time>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <ThreadsFollowSoft
      lang={lang === 'en' ? 'en' : 'zh-Hant'}
      class="soft-follow article-follow"
    />
    {
      navigation && (
        <ArticleNavigation placement="bottom" lang={lang} {...navigation} />
      )
    }
  </article>
</BaseLayout>
