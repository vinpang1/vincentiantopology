---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  narrow?: boolean;
  lang?: 'zh-Hant' | 'en';
}

const {
  title,
  description = site.description,
  narrow = false,
  lang = 'zh-Hant',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Noto+Serif+TC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主內容</a>
    <SiteHeader />
    <main id="main" class="site-main">
      <div class={narrow ? 'container container--narrow' : 'container'}>
        <slot />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-site-nav]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (toggle?.contains(event.target) || nav?.contains(event.target)) return;
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  });
</script>
